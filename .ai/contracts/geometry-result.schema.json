{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bendpipe-pro.local/schema/geometry-result.schema.json",
  "title": "Confidence-bearing geometry value",
  "type": "object",
  "additionalProperties": false,
  "required": ["value", "confidence", "reason", "method", "source"],
  "properties": {
    "value": {},
    "unit": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "reason": {"type": ["string", "null"]},
    "method": {"type": "string", "minLength": 1},
    "source": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "truth_category": {
      "enum": ["source", "derived", "inferred", "user_confirmed"]
    }
  }
}
