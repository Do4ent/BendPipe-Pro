{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bendpipe-pro.local/schema/canonical-tube-geometry.schema.json",
  "title": "CanonicalTubeGeometry",
  "description": "Nominal recognized/design tube geometry. Machine/tool/material compensation is intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tube_id",
    "length_unit",
    "angle_unit",
    "coordinate_frame",
    "primitives"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "tube_id": {
      "type": "string",
      "minLength": 1
    },
    "length_unit": {
      "const": "mm"
    },
    "angle_unit": {
      "const": "deg"
    },
    "coordinate_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "handedness"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "handedness": {
          "enum": [
            "right",
            "left"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "primitives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/line"
          },
          {
            "$ref": "#/$defs/bend"
          }
        ]
      }
    }
  },
  "$defs": {
    "confidenceValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidence",
        "reason",
        "method",
        "source",
        "truth_category"
      ],
      "properties": {
        "value": {},
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "truth_category": {
          "enum": [
            "source",
            "derived",
            "inferred",
            "user_confirmed"
          ]
        }
      }
    },
    "pointValue": {
      "allOf": [
        {
          "$ref": "#/$defs/confidenceValue"
        },
        {
          "properties": {
            "value": {
              "type": [
                "array",
                "null"
              ],
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "numberValue": {
      "allOf": [
        {
          "$ref": "#/$defs/confidenceValue"
        },
        {
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      ]
    },
    "vectorValue": {
      "allOf": [
        {
          "$ref": "#/$defs/confidenceValue"
        },
        {
          "properties": {
            "value": {
              "type": [
                "array",
                "null"
              ],
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "element_id",
        "start",
        "end",
        "length",
        "direction"
      ],
      "properties": {
        "type": {
          "const": "LINE"
        },
        "element_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "$ref": "#/$defs/pointValue"
        },
        "end": {
          "$ref": "#/$defs/pointValue"
        },
        "length": {
          "$ref": "#/$defs/numberValue"
        },
        "direction": {
          "$ref": "#/$defs/vectorValue"
        }
      }
    },
    "bend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "element_id",
        "tangent_in",
        "tangent_out",
        "center",
        "bend_plane_normal",
        "clr",
        "angle"
      ],
      "properties": {
        "type": {
          "const": "BEND"
        },
        "element_id": {
          "type": "string",
          "minLength": 1
        },
        "tangent_in": {
          "$ref": "#/$defs/pointValue"
        },
        "tangent_out": {
          "$ref": "#/$defs/pointValue"
        },
        "center": {
          "$ref": "#/$defs/pointValue"
        },
        "bend_plane_normal": {
          "$ref": "#/$defs/vectorValue"
        },
        "clr": {
          "$ref": "#/$defs/numberValue",
          "description": "Centerline radius owned by this bend. Tooling may validate this value but must not redefine it silently."
        },
        "angle": {
          "$ref": "#/$defs/numberValue",
          "description": "Signed nominal geometric bend angle in degrees."
        },
        "plane_rotation_from_previous": {
          "$ref": "#/$defs/numberValue"
        }
      }
    }
  }
}
