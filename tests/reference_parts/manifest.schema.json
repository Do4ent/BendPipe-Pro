{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bendpipe-pro.local/schema/reference-part-manifest.schema.json",
  "title": "BendPipe-Pro reference part manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "description", "source", "expected_geometry", "tolerances"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["format", "file"],
      "properties": {
        "format": {"enum": ["DWFx", "STEP", "DWG", "DXF"]},
        "file": {"type": "string"},
        "units": {"type": ["string", "null"]},
        "coordinate_system_notes": {"type": ["string", "null"]}
      }
    },
    "expected_geometry": {"type": "string"},
    "tolerances": {
      "type": "object",
      "required": ["length", "angle"],
      "properties": {
        "length": {"type": "number", "minimum": 0},
        "angle": {"type": "number", "minimum": 0}
      }
    },
    "expected_ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "reason"],
        "properties": {
          "field": {"type": "string"},
          "reason": {"type": "string"},
          "confidence_min": {"type": "number", "minimum": 0, "maximum": 1},
          "confidence_max": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
